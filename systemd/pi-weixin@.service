# pi-weixin-daemon systemd user unit (template)
#
# One daemon per project. `%i` is the systemd instance name; give it a short
# project id, e.g.:
#
#   systemctl --user start pi-weixin@project-a
#
# Set PI_WEIXIN_CWD and PI_WEIXIN_ACCOUNTS (space-separated) in
# ~/.config/pi-weixin/%i.env, or edit ExecStart below with literal values.
#
# Example ~/.config/pi-weixin/project-a.env:
#   PI_WEIXIN_CWD=/home/you/code/project-a
#   PI_WEIXIN_ACCOUNTS=account-a account-b
#
# Full literal example (no env file):
#   ExecStart=/home/you/.local/bin/pi-weixin-daemon run \
#     --cwd /home/you/code/project-a \
#     --account account-a --account account-b

[Unit]
Description=Pi Weixin Daemon (%i)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/pi-weixin/%i.env
ExecStart=%h/.local/bin/pi-weixin-daemon run --cwd ${PI_WEIXIN_CWD} --account ${PI_WEIXIN_ACCOUNTS}
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
