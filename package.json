{
  "name": "pi-weixin-daemon",
  "version": "0.5.0",
  "packageManager": "pnpm@11.25.0",
  "description": "Connect Weixin iLink Bot with Pi Coding Agent",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-wx": "./dist/index.js"
  },
  "files": [
